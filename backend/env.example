# Export these variables in your terminal; server.py does not load this file automatically.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=servesync
DB_USER=servesync_app
DB_PASSWORD=replace-with-local-database-password
PIN_LOOKUP_SECRET=replace-with-a-random-secret-at-least-32-characters
API_HOST=127.0.0.1
PORT=8000

# --- Optional integrations (Sprint 4). The API works without them. ---
# AI-written summaries for customer reviews (FR-8) and consumption analytics (FR-10), and the
# Copilot chat. Without a key the built-in engine writes the summaries and the chat answers.
# GEMINI_API=            (Google Gemini; used first when set. GEMINI_MODEL optionally names the model.)
# ANTHROPIC_API_KEY=     (Claude; used when no Gemini key is set)
# SERVESYNC_AI_MODEL=claude-opus-5-5
# Delivery platforms (FR-15). A platform is "Not connected" until its webhook secret is set.
# The platform sends new orders to POST /delivery/webhook/doordash (or /ubereats) with the
# secret as a Bearer token. STATUS_URL and API_TOKEN are used to send status updates back.
# DOORDASH_WEBHOOK_SECRET=
# DOORDASH_STATUS_URL=
# DOORDASH_API_TOKEN=
# UBEREATS_WEBHOOK_SECRET=
# UBEREATS_STATUS_URL=
# UBEREATS_API_TOKEN=
# Google reviews import (FR-8) through the Google Places API.
# GOOGLE_PLACES_API_KEY=
# GOOGLE_PLACE_ID=
